# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fin_dw
POSTGRES_USER=fin
POSTGRES_PASSWORD=fin

# Assets (comma-separated)
TICKERS=AAPL,MSFT,TSLA

# Price source:
# - yahoo  : Yahoo Finance via yfinance (may be rate limited during frequent testing)
# - stooq  : Stooq CSV (good for dev/testing). For US stocks it maps AAPL -> AAPL.US
PRICE_SOURCE=stooq

# News RSS (template supports {ticker})
NEWS_RSS_TEMPLATE=https://news.google.com/rss/search?q={ticker}%20stock&hl=en-US&gl=US&ceid=US:en

# Pipeline
LOOKBACK_HOURS=168
PIPELINE_TZ=Asia/Bangkok

# Debug
NEWS_DEBUG=1
